# Freeze or Throw .gitattributes
# 1) Normalise line endings for text files
# 2) Route Unity scenes/prefabs through UnityYAMLMerge (Smart Merge)
# 3) Store real binaries in Git LFS

* text=auto

# ---------------------------------------------------------------
# Code and text
# ---------------------------------------------------------------
*.cs        text diff=csharp
*.shader    text
*.hlsl      text
*.cginc     text
*.compute   text
*.json      text
*.xml       text
*.md        text
*.txt       text
*.uxml      text
*.uss       text
*.inputactions text

# ---------------------------------------------------------------
# Unity YAML files: keep in normal git (diffable), LF endings,
# merged with UnityYAMLMerge. Every teammate must configure the
# "unityyamlmerge" driver once (see README, "Smart Merge").
# Without that config git just falls back to a normal merge.
# ---------------------------------------------------------------
*.unity          text eol=lf merge=unityyamlmerge linguist-generated
*.prefab         text eol=lf merge=unityyamlmerge linguist-generated
*.asset          text eol=lf merge=unityyamlmerge linguist-generated
*.mat            text eol=lf merge=unityyamlmerge linguist-generated
*.anim           text eol=lf merge=unityyamlmerge linguist-generated
*.controller     text eol=lf merge=unityyamlmerge linguist-generated
*.overrideController text eol=lf merge=unityyamlmerge linguist-generated
*.physicMaterial text eol=lf merge=unityyamlmerge linguist-generated
*.physicsMaterial2D text eol=lf merge=unityyamlmerge linguist-generated
*.playable       text eol=lf merge=unityyamlmerge linguist-generated
*.mask           text eol=lf merge=unityyamlmerge linguist-generated
*.brush          text eol=lf merge=unityyamlmerge linguist-generated
*.flare          text eol=lf merge=unityyamlmerge linguist-generated
*.fontsettings   text eol=lf merge=unityyamlmerge linguist-generated
*.guiskin        text eol=lf merge=unityyamlmerge linguist-generated
*.giparams       text eol=lf merge=unityyamlmerge linguist-generated
*.renderTexture  text eol=lf merge=unityyamlmerge linguist-generated
*.spriteatlas    text eol=lf merge=unityyamlmerge linguist-generated
*.spriteatlasv2  text eol=lf merge=unityyamlmerge linguist-generated
*.terrainlayer   text eol=lf merge=unityyamlmerge linguist-generated
*.mixer          text eol=lf merge=unityyamlmerge linguist-generated
*.shadervariants text eol=lf merge=unityyamlmerge linguist-generated
*.preset         text eol=lf merge=unityyamlmerge linguist-generated
*.lighting       text eol=lf merge=unityyamlmerge linguist-generated
*.meta           text eol=lf merge=unityyamlmerge linguist-generated

# Baked lighting data is binary even with Force Text serialisation
**/LightingData.asset filter=lfs diff=lfs merge=lfs -text

# ---------------------------------------------------------------
# Git LFS: binaries only
# ---------------------------------------------------------------
# Images (UI sprites are PNG @2x)
*.png  filter=lfs diff=lfs merge=lfs -text
*.jpg  filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.tga  filter=lfs diff=lfs merge=lfs -text
*.tif  filter=lfs diff=lfs merge=lfs -text
*.tiff filter=lfs diff=lfs merge=lfs -text
*.psd  filter=lfs diff=lfs merge=lfs -text
*.exr  filter=lfs diff=lfs merge=lfs -text
*.hdr  filter=lfs diff=lfs merge=lfs -text
*.gif  filter=lfs diff=lfs merge=lfs -text
*.bmp  filter=lfs diff=lfs merge=lfs -text
*.svg  filter=lfs diff=lfs merge=lfs -text

# 3D models (export .fbx from Blender; .blend only in SourceArt/)
*.fbx   filter=lfs diff=lfs merge=lfs -text
*.FBX   filter=lfs diff=lfs merge=lfs -text
*.obj   filter=lfs diff=lfs merge=lfs -text
*.glb   filter=lfs diff=lfs merge=lfs -text
*.gltf  filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text

# Audio
*.wav  filter=lfs diff=lfs merge=lfs -text
*.mp3  filter=lfs diff=lfs merge=lfs -text
*.ogg  filter=lfs diff=lfs merge=lfs -text
*.aif  filter=lfs diff=lfs merge=lfs -text
*.aiff filter=lfs diff=lfs merge=lfs -text
*.flac filter=lfs diff=lfs merge=lfs -text

# Video
*.mp4  filter=lfs diff=lfs merge=lfs -text
*.mov  filter=lfs diff=lfs merge=lfs -text
*.webm filter=lfs diff=lfs merge=lfs -text

# Fonts (Baloo 2)
*.ttf filter=lfs diff=lfs merge=lfs -text
*.otf filter=lfs diff=lfs merge=lfs -text

# Native plugins and archives (Photon ships some DLLs)
*.dll    filter=lfs diff=lfs merge=lfs -text
*.so     filter=lfs diff=lfs merge=lfs -text
*.dylib  filter=lfs diff=lfs merge=lfs -text
*.bundle filter=lfs diff=lfs merge=lfs -text
*.zip    filter=lfs diff=lfs merge=lfs -text
*.7z     filter=lfs diff=lfs merge=lfs -text
*.pdf    filter=lfs diff=lfs merge=lfs -text
