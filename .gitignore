# Unity .gitignore for Freeze or Throw
# Based on GitHub's official template: https://github.com/github/gitignore/blob/main/Unity.gitignore
# The Unity project lives at the root of this repo (Assets/, Packages/, ProjectSettings/ next to this file).

.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
*.log

# Blender backup files
*.blend1
*.blend1.meta

# Memory captures and recordings can get huge
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Autogenerated JetBrains Rider plugin and personal settings
/[Aa]ssets/Plugins/Editor/JetBrains*
*.DotSettings.user

# IDE caches and generated solution/project files
.vs/
.idea/
.gradle/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity generated meta files for the above
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash reports and Mono
sysinfo.txt
mono_crash.*

# Builds and packages (share builds through Drive/itch, not git)
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app
*.exe

# Crashlytics
crashlytics-build.properties

# Test Runner / play mode test scenes
InitTestScene*.unity*
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# Addressables
/ServerData
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Visual Scripting generated files
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.bytes
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.bytes.meta
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# OS junk
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini
